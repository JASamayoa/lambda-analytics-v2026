# lambda Learn · variables de entorno
# Copiá este archivo a .env.local (no commitear) y completá los valores.
# En Vercel: Settings → Environment Variables → pegar uno por uno.

# ===== Neon Postgres =====
# 1. Crear database en https://console.neon.tech/
# 2. Settings → Connection Details → toggle "Pooled connection" → Copy snippet
# 3. Pegar aquí completo, incluyendo ?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://USER:PASS@HOST-pooler.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ===== Resend (email transaccional) =====
# 1. Signup en https://resend.com con jorge@scilambda.net (gratis)
# 2. Domains → Add domain → scilambda.net → agregar los 3 DNS records (SPF, DKIM, DMARC)
# 3. API Keys → Create → copy
RESEND_API_KEY="re_XxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxX"
RESEND_FROM="lambda Learn <learn@scilambda.net>"

# ===== Destinatario interno =====
# Mailbox que recibe la notificación de nuevos leads
ADMIN_EMAIL="learn@scilambda.net"

# ===== App =====
APP_URL="https://learn.lambda-analytics.net"
NODE_ENV="production"
